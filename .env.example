# OpenRouter API Key
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# LiteLLM Gateway Configuration
LITELLM_MASTER_KEY=sk-gateway-your-key-here
DATABASE_URL=postgresql://postgres:litellm@localhost/litellm

# Logging
LOG_LEVEL=INFO

# Gateway Port
GATEWAY_PORT=4000

# Flask API Port
FLASK_PORT=5000

# FastAPI Port
FASTAPI_PORT=8000

# Environment
ENVIRONMENT=development
